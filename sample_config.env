# WilliamButcherBot Configuration
# Only for Docker/Railway Deployment

# ============ TELEGRAM BOT CONFIGURATION ============
# Get BOT_TOKEN from @BotFather
BOT_TOKEN=your_bot_token

# Get API_ID and API_HASH from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash

# Userbot session string (optional, generate via str_gen.py)
SESSION_STRING=

# Phone number for userbot (if SESSION_STRING is empty)
PHONE_NUMBER=

# ============ USER & PERMISSIONS ============
# Space-separated Sudo users (have full access to everything)
SUDO_USERS_ID=682966383

# Userbot command prefix
USERBOT_PREFIX=\

# ============ LOGGING ============
# Log group ID (must be negative)
LOG_GROUP_ID=-125639839

# Global ban log group ID (negative)
GBAN_LOG_GROUP_ID=-173738999

# Message dump chat ID (negative)
MESSAGE_DUMP_CHAT=-173738999

# ============ DATABASE ============
# PostgreSQL connection string (NEW - replaces MongoDB)
DATABASE_URL=postgresql://user:password@localhost/wbb

# ============ EXTERNAL SERVICES ============
# ARQ API endpoint
ARQ_API_URL=https://arq.hamker.dev

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============ FEATURES ============
WELCOME_DELAY_KICK_SEC=300
LOG_MENTIONS=0
RSS_DELAY=300
PM_PERMIT=1

# ============ APPLICATION SETTINGS ============
TZ=Asia/Amman
MAX_CONCURRENT_TASKS=2
LOG_LEVEL=true
PYTHONUNBUFFERED=1
